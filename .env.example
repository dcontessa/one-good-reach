# One Good Reach environment example.
# Copy to .env and fill in the RevenueCat key for the target platform.
# Check-ins, relationship labels, and reflections remain on this device.

# RevenueCat public SDK keys (platform specific, safe for the client)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Use false in a development or production build after RevenueCat is configured.
EXPO_PUBLIC_FORCE_MOCK=true
